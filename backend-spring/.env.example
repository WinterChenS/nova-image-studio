# Nova Studio Backend — M0 spike local environment template
# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit real credentials.
#
# PostgreSQL (external server)
DB_HOST=192.168.3.10
DB_PORT=5432
DB_USERNAME=app_user
DB_PASSWORD=CHANGE_ME
# Database name: user-confirmed `nova` (created for M0; see WIN-10 comments)
DB_NAME=nova

# Redis (external server)
REDIS_HOST=192.168.3.10
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# Server
PORT=8080
