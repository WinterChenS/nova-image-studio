# Nova Studio Backend — M1 (WIN-11) local environment template
# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit real credentials.
#
# PostgreSQL (external server; user-confirmed database name `nova`)
DB_HOST=192.168.3.10
DB_PORT=5432
DB_USERNAME=app_user
DB_PASSWORD=CHANGE_ME
DB_NAME=nova

# Redis (external server)
REDIS_HOST=192.168.3.10
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# Server
PORT=8080

# ============================================================================
# Runtime (hot-read from .env with 1s TTL — matching the Node backend semantics)
# ============================================================================

# Image storage directory (files named {taskId}-{itemIndex}-{subIndex}.{ext})
NOVA_IMAGE_DIR=./data/nova-images

# Static hosting root (Next.js static export)
NOVA_STATIC_DIR=../frontend/out

# Prompt gallery / blacklist file paths (file-backed in M1; DB-ized in P1/T3.1)
NOVA_PROMPTS_PATH=../backend/prompts.json
NOVA_BLACKLIST_PATH=../backend/blacklist.json

# Ops switches (A.5-Q4/H4: must stay on .env, never in the DB)
# NOVA_ACCEPT_NEW_TASKS=true
# NOVA_REJECT_NEW_TASKS=false

# Queue / limits (defaults match the Node backend)
# NOVA_TASK_CONCURRENCY=50
# NOVA_MAX_QUEUE_SIZE=200
# NOVA_RATE_LIMIT_WINDOW_MS=60000
# NOVA_RATE_LIMIT_MAX_REQUESTS_PER_IP=20
# NOVA_RATE_LIMIT_MAX_REQUESTS_PER_API_KEY=20
# NOVA_MAX_PENDING_TASKS_PER_IP=20
# NOVA_MAX_PENDING_TASKS_PER_API_KEY=10
# NOVA_RATE_LIMIT_RETRY_AFTER_SECONDS=30

# Image streaming (ADR-4)
# NOVA_IMAGE_STREAM=true
# NOVA_IMAGE_PARTIAL_IMAGES=1

# Prompt gallery
# PROMPT_GALLERY_MODE=1
# PROMPT_GALLERY_PASSWORD=8848
