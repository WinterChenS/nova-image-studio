# Nova Image Studio — 基础设施配置模板（T3.5 / WIN-13）
# 复制为 `.env` 并按需修改；`.env` 与所有 `.env.*` 变体已被 .gitignore 忽略。
# AI API Key 一律在数据库（settings 接口写入，AES-GCM 加密），不写在这里（PRD §10.2）。
#
# docker compose 场景（内置 PG/Redis）：
#   1) cp .env.example .env
#   2) docker compose up -d --build
#   3) 打开 http://localhost:3000 → 注册账号 → 设置页配置模型与 API Key
#   4) 需要管理接口时：在 .env 加 NOVA_ADMIN_USERNAME=<已注册用户名> 后重启

# PostgreSQL（compose 内置时指向 postgres 服务；外部部署改为实际主机）
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=nova
DB_PASSWORD=nova
DB_NAME=nova

# Redis（compose 内置时指向 redis 服务）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# 应用端口（对外 3000）
PORT=3000

# 加密主密钥与 JWT 签名密钥（必填！生成：openssl rand -base64 32 / 48）
NOVA_SETTINGS_SECRET_KEY=CHANGE_ME_base64_32_bytes
NOVA_JWT_SECRET=CHANGE_ME_base64_48_bytes

# 可选：管理员提权（T3.1，值为已注册用户名）
# NOVA_ADMIN_USERNAME=admin

# ---- WIN-25 / WIN-29（账号池·审计·RBAC）可选调优 ----
# 用量/审计保留期（天，默认 180；usage_records 与 audit_log 同保留期）
# NOVA_AUDIT_RETENTION_DAYS=180
# 账号连续失败达阈值 → broken（默认 3，需人工恢复）
# NOVA_ACCOUNT_BROKEN_THRESHOLD=3
# 用量日聚合：回看窗口（默认 2 天 = 昨日+今日）与时区（默认 Asia/Shanghai）
# NOVA_DAILY_AGG_LOOKBACK_DAYS=2
# NOVA_DAILY_AGG_TIMEZONE=Asia/Shanghai
# 账号月度费用上限检查周期（毫秒，默认 5 分钟；达限自动 paused）
# NOVA_MONTHLY_CAP_CHECK_INTERVAL_MS=300000
# 主动健康探测周期（毫秒，默认 10 分钟；轻量 /models 探活）
# NOVA_ACCOUNT_PROBE_INTERVAL_MS=600000
